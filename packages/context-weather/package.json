{
  "type": "module",
  "name": "@oh-my-pi/context-weather",
  "version": "16.3.11",
  "description": "Context Weather — an ambient animated barometer showing context-window pressure and pre-compaction storms",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/context-weather"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "tui",
    "context",
    "animation",
    "barometer",
    "extension",
    "plugin",
    "cli"
  ],
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test --parallel test/*.test.ts",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@oh-my-pi/pi-animation": "catalog:",
    "@oh-my-pi/pi-tui": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^16"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "omp": {
    "name": "Context Weather",
    "description": "Ambient animated barometer showing context-window pressure and pre-compaction storms.",
    "extensions": [
      "./src/extension.ts"
    ],
    "settings": {
      "animations": {
        "type": "enum",
        "description": "Motion tier for the barometer (gated to 'off' on non-TTY/CI/NO_COLOR).",
        "values": ["off", "subtle", "full"],
        "default": "off",
        "env": "OMP_CONTEXT_WEATHER_ANIMATIONS"
      },
      "contextWeatherStyle": {
        "type": "enum",
        "description": "Barometer glyph style.",
        "values": ["tide", "bar", "barometer"],
        "default": "tide",
        "env": "OMP_CONTEXT_WEATHER_STYLE"
      },
      "contextWeatherPlacement": {
        "type": "enum",
        "description": "Where the widget mounts relative to the input editor.",
        "values": ["aboveEditor", "belowEditor"],
        "default": "aboveEditor",
        "env": "OMP_CONTEXT_WEATHER_PLACEMENT"
      },
      "contextWeatherStormAtPercent": {
        "type": "number",
        "description": "Fallback storm threshold (context %) used when the model exposes no tokens-until-compaction forecast.",
        "default": 85,
        "min": 0,
        "max": 100,
        "step": 1,
        "env": "OMP_CONTEXT_WEATHER_STORM_AT_PERCENT"
      },
      "contextWeatherNotifyOnImminent": {
        "type": "boolean",
        "description": "Show a one-shot notification the first time a storm (imminent auto-compaction) is detected.",
        "default": true,
        "env": "OMP_CONTEXT_WEATHER_NOTIFY_ON_IMMINENT"
      }
    }
  }
}
